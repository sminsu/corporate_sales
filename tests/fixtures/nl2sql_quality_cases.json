{
  "json_parsing": [
    {
      "name": "plain_object",
      "input": "{\"tool\": \"NONE\"}",
      "expected": {"tool": "NONE"}
    },
    {
      "name": "fenced_object",
      "input": "```json\n{\"tool\": \"대손비용률_분석\", \"params\": {\"기준년월\": \"202512\"}}\n```",
      "expected": {
        "tool": "대손비용률_분석",
        "params": {"기준년월": "202512"}
      }
    },
    {
      "name": "reasoning_and_trailing_text",
      "input": "<reasoning>후보를 검토한다.</reasoning>\n```json\n{\"tool\": \"NONE\"}\n```\n이상이 최종 결과입니다.",
      "expected": {"tool": "NONE"}
    },
    {
      "name": "preamble_and_nested_object",
      "input": "요청한 JSON입니다.\n{\"tool\": \"대손비용률_분석\", \"params\": {\"기업명\": \"한빛테크\", \"옵션\": {\"등급별\": true}}}\n참고하세요.",
      "expected": {
        "tool": "대손비용률_분석",
        "params": {
          "기업명": "한빛테크",
          "옵션": {"등급별": true}
        }
      }
    }
  ],
  "sql_extraction": [
