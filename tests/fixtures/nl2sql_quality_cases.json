    {
      "name": "fenced_sql",
      "input": "```sql\nSELECT 기준년월 FROM tmdaa3e16 LIMIT 10;\n```",
      "expected": "SELECT 기준년월 FROM tmdaa3e16 LIMIT 10;"
    },
    {
      "name": "preamble_fenced_sql",
      "input": "아래 SQL을 사용하세요.\n```sql\nSELECT 기준년월 FROM tmdaa3e16 LIMIT 10;\n```\n설명은 생략합니다.",
      "expected": "SELECT 기준년월 FROM tmdaa3e16 LIMIT 10;"
    },
    {
      "name": "think_then_plain_sql",
      "input": "<think>테이블과 컬럼을 확인한다.</think>\nSELECT 기준년월 FROM tmdaa3e16 LIMIT 10;",
      "expected": "SELECT 기준년월 FROM tmdaa3e16 LIMIT 10;"
    },
    {
      "name": "preamble_then_plain_sql",
      "input": "요청을 반영한 SQL입니다.\nSELECT 기준년월 FROM tmdaa3e16 LIMIT 10;",
      "expected": "SELECT 기준년월 FROM tmdaa3e16 LIMIT 10;"
    }
  ],
