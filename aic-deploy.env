# 프로젝트별 배포 설정.
# 이 파일은 소스와 함께 s3://aihub-dev-ane2-agent/deploy/{식별자}/ 로 업로드한다.

PROJECT_NAME=corporate-sales-t2s

# 지원값: agent, data-pipeline, evaluation
# agent는 AI Agent 클러스터, data-pipeline은 데이터 파이프라인 클러스터,
# evaluation은 평가 클러스터로 매핑된다.
WORKLOAD_TYPE=agent

# svc: ECS service 생성/업데이트까지 수행
# task: Task Definition revision 등록까지만 수행
DEPLOY_TYPE=svc

TASK_FAMILY=corporate-sales-t2s
SERVICE_NAME=corporate-sales-t2s-svc
CONTAINER_NAME=corporate-sales-t2s

# 필수값. 현재 사내 서비스는 18000~18030 범위를 사용한다.
CONTAINER_PORT=8080

# 비워두면 기본값 사용: CPU=2048(2 vCPU), MEMORY=8192(8GB)
CPU=
MEMORY=

# DEPLOY_TYPE=svc 최초 service 생성 시에만 사용한다.
# 기존 service 재배포 시 desired count, LB, service discovery, network config는 건드리지 않는다.
DESIRED_COUNT=1
