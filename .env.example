# kbcard-agent-common style config entrypoint
KBCARD_CONFIG_PATH=config/agent.example.yaml

# Local vLLM / OpenAI-compatible LLM secret.
# Use EMPTY for unauthenticated local vLLM, or set a real key if the gateway requires one.
LLM_API_KEY=EMPTY

# Database backend: "postgres" (default) or "athena".
DB_BACKEND=postgres

# --- PostgreSQL (DB_BACKEND=postgres) ---
# The common examples keep DB secrets outside YAML via KBCARD_POSTGRES_DSN.
KBCARD_POSTGRES_DSN=host=127.0.0.1 port=5432 dbname=postgres user=postgres password=your-password

# --- Web session persistence (ECS/ALB 운영 권장) ---
# auto: WEBAPP_POSTGRES_DSN/KBCARD_POSTGRES_DSN 등 Postgres DSN이 있으면 postgres,
#       없으면 로컬 데모용 memory 저장소를 사용한다.
WEBAPP_SESSION_STORE=auto
# 업무 조회 DB와 세션 저장 DB를 분리하려면 별도 DSN을 지정한다.
# 지정하지 않으면 KBCARD_POSTGRES_DSN/DATABASE_URL/DB_DSN 등을 재사용한다.
# WEBAPP_POSTGRES_DSN=host=127.0.0.1 port=5432 dbname=postgres user=postgres password=your-password
# 세션 테이블을 만들 PostgreSQL schema. 기본값은 corporate_sales.
WEBAPP_POSTGRES_SCHEMA=corporate_sales
# 선택: Redis는 source of truth가 아니라 result/file token 보조 캐시로만 사용한다.
# WEBAPP_REDIS_URL=redis://127.0.0.1:6379/0
# WEBAPP_REDIS_TTL_SECONDS=86400
# 보존 정책. 0이면 해당 제한을 끈다.
WEBAPP_MAX_SESSIONS_PER_USER=50
WEBAPP_MAX_MESSAGES_PER_SESSION=80
WEBAPP_RESULT_RETENTION_DAYS=7
WEBAPP_FILE_RETENTION_DAYS=7
WEBAPP_SESSION_RETENTION_DAYS=60

# --- Amazon Athena (DB_BACKEND=athena) ---
# 인증은 표준 AWS 자격증명 체인(환경변수/AWS_PROFILE/IAM 역할)을 사용한다.
# ATHENA_REGION=ap-northeast-2
# ATHENA_S3_STAGING_DIR=s3://your-athena-results-bucket/path/   # 워크그룹에 결과 위치가 있으면 생략 가능
# ATHENA_WORKGROUP=primary
# ATHENA_DATABASE=card_system
# ATHENA_CATALOG=AwsDataCatalog
# ATHENA_PROFILE=your-aws-profile   # 선택: 기본 자격증명 체인 대신 특정 프로필 사용 시
# ATHENA_ENDPOINT_URL=https://vpce-xxxx.athena.ap-northeast-2.vpce.amazonaws.com  # 선택: VPC 엔드포인트/사내 프록시

# 테이블 prefix(스키마/Glue DB 이름). 미설정 시 postgres=card_system, athena=ATHENA_DATABASE.
# 모든 SQL·검증·프롬프트·schema YAML의 physical_table에 일괄 적용된다.
# prefix를 완전히 빼려면 DB_SCHEMA=none (pyathena는 schema_name을 이미 알고 있음).
# DB_SCHEMA=card_system

# Text2SQL semantic schema and output paths.
SEMANTIC_SCHEMA_PATH=./schema_v6_gptoss.yaml
BAD_DEBT_OUTPUT_DIR=./output
